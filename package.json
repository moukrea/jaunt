{
  "name": "jaunt-desktop",
  "version": "0.1.0-beta.36",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare-web": "node scripts/prepare_web.mjs",
    "test:relay": "node --test tests/relay.miniflare.mjs",
    "test": "node --test tests/linear_routing.test.mjs tests/linear_waits.test.mjs tests/linear_activity.test.mjs tests/linear_landing.test.mjs tests/linear_skills.test.mjs tests/relay.test.mjs tests/js.test.mjs tests/desktop_updates.test.cjs tests/host_errors.test.cjs tests/linear_codex.test.mjs tests/linear_workers.test.mjs tests/linear_wakes.test.mjs tests/linear_attribution.test.mjs",
    "desktop": "electron .",
    "build:desktop": "electron-builder --linux tar.gz deb --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "jsqr": "1.4.0",
    "lucide": "1.46.0"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "meteor-icons": "4.4.0",
    "miniflare": "4.20260730.0",
    "sharp": "0.35.4",
    "wrangler": "4.131.2"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4",
      "undici": "7.29.0"
    }
  },
  "main": "desktop/main.cjs",
  "description": "Shared local and remote terminal workspace",
  "author": "jaunt contributors",
  "license": "MIT",
  "build": {
    "appId": "dev.jaunt.desktop",
    "productName": "jaunt",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "desktop/**",
      "web/**",
      "package.json"
    ],
    "linux": {
      "executableName": "jaunt-desktop",
      "icon": "desktop/icons",
      "category": "TerminalEmulator",
      "desktop": {
        "entry": {
          "StartupWMClass": "jaunt",
          "Comment": "Shared local and remote terminal workspace"
        }
      },
      "maintainer": "moukrea <moukrea@users.noreply.github.com>",
      "syncDesktopName": true,
      "target": [
        "tar.gz",
        "deb",
        "rpm"
      ]
    },
    "artifactName": "jaunt-desktop-${version}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "desktop/icons/512x512.png",
        "to": "jaunt.png"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "zip",
        "dmg"
      ],
      "identity": null,
      "icon": "web/assets/jaunt.png"
    },
    "afterPack": "desktop/after-pack.cjs",
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1",
        "pkexec",
        "libdrm2",
        "libxkbcommon0"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "polkit",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "alsa-lib",
        "mesa-libgbm",
        "libdrm",
        "libxkbcommon",
        "libsecret"
      ]
    },
    "beforePack": "desktop/before-pack.cjs"
  },
  "desktopName": "dev.jaunt.desktop.desktop"
}
